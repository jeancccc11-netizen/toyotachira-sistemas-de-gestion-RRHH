# ================= SI-GHR Backend =================
# Copia a backend/.env y completa los valores.

NODE_ENV=development
PORT=3001

# -- Base de datos (Supabase/Postgres) --
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
# Alternativa: cadena completa (tiene prioridad en algunos scripts)
# DATABASE_URL=postgresql://user:pass@host:6543/postgres

# -- Seguridad --
# OBLIGATORIO en producción (32+ caracteres aleatorios). Sin esto el backend no arranca.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Orígenes permitidos para CORS, separados por coma. Ejemplo:
# CORS_ORIGINS=https://toyotachira-rrhh.vercel.app,https://rrhh.toyotachira.com

# -- Archivos --
UPLOAD_DIR=./uploads
