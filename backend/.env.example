# SI-GHR Backend Configuration
# Copy this to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sighr
DB_USER=sighr_admin
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=8h

# Uploads
UPLOAD_DIR=./uploads
